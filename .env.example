# Copy to .env.local and fill in values from your Supabase project settings
# (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Direct Postgres connection, used ONLY by scripts/db.mjs for local development
# queries and migration verification. Not read by the app and never bundled.
# Supabase dashboard -> Project Settings -> Database -> Connection string
# -> Session pooler. Replace [YOUR-PASSWORD] with your database password.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-1-region.pooler.supabase.com:5432/postgres
