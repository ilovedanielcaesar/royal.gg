# Copy to .env.local and fill in values from your Supabase project settings
# (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public origin used to build shareable /join links, set in Vercel for the
# deployed app. Auth redirects deliberately keep using the live origin instead.
# Left commented out on purpose: unset, /join links fall back to the origin the
# page was opened from, which is what you want locally. A copied-but-unedited
# value here would point every invite at a host that does not exist.
# VITE_PUBLIC_APP_URL=https://your-app.vercel.app

# Direct Postgres connection, used ONLY by scripts/db.mjs for local development
# queries and migration verification. Not read by the app and never bundled.
# Supabase dashboard -> Project Settings -> Database -> Connection string
# -> Session pooler. Replace [YOUR-PASSWORD] with your database password.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-1-region.pooler.supabase.com:5432/postgres
